@{
    Layout = "~/Areas/Management/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Nhà xe";
    ViewData["AdminNav"] = "nhaxe";
}

<!-- ===== Title Bar ===== -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:24px;">
    <div>
        <h2 style="margin:0;font-size:1.55rem;font-weight:700;color:#1e293b;">🏢 Danh sách Nhà xe</h2>
        <p style="margin:4px 0 0;font-size:.93rem;color:#64748b;">Quản lý thông tin nhà xe trong hệ thống</p>
    </div>
    <a href="#" class="admin-topbar-btn" style="background:#3b82f6;color:white;border-color:#3b82f6;text-decoration:none;padding:9px 20px;border-radius:8px;font-weight:600;font-size:.93rem;display:inline-flex;align-items:center;gap:6px;">
        + Thêm nhà xe
    </a>
</div>

<!-- ===== Filter Bar ===== -->
<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:20px;">
    <input type="text" placeholder="Tìm theo tên, SĐT, email..." style="flex:1;min-width:220px;padding:9px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:.93rem;outline:none;transition:border .2s;" onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#cbd5e1'" />
    <button class="admin-topbar-btn" style="background:#3b82f6;color:white;border-color:#3b82f6;padding:9px 22px;border-radius:8px;font-weight:600;font-size:.93rem;cursor:pointer;">
        🔍 Lọc
    </button>
</div>

