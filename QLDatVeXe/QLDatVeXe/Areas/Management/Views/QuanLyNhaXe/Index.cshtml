@{
    ViewBag.Title    = "Quản lý Nhà xe";
    ViewBag.PageName = "NhaXe";

    var nhaXes = ViewBag.NhaXes as List<QLDatVeXe.Models.Nhaxe> ?? new();
    var search  = ViewBag.Search as string ?? "";
}

<!-- Toolbar -->
<div class="toolbar">
    <form method="get" class="toolbar-search">
        <div class="search-box">
            <span class="search-icon">🔍</span>
            <input type="text" name="search" value="@search"
                   placeholder="Tìm theo tên nhà xe, SĐT…"
                   class="search-input" />
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Tìm kiếm</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a href="@Url.Action("Index")" class="btn btn-ghost btn-sm">✕ Xóa</a>
        }
    </form>
    <div class="toolbar-stats">
        <span class="stat-badge">Tổng: <b>@nhaXes.Count</b> nhà xe</span>
    </div>
</div>

<!-- Cards grid -->
<div class="nhaxe-grid">
    @foreach (var nx in nhaXes)
    {
        var tongXe     = nx.Xe.Count;
        var tongChuyen = nx.Xe.Sum(x => x.Chuyenxe.Count);
        var colors     = new[] { "#2563eb","#7c3aed","#059669","#d97706","#dc2626","#0891b2" };
        var color      = colors[Math.Abs(nx.MaNhaXe.GetHashCode()) % colors.Length];

        <div class="nhaxe-card">
            <div class="nhaxe-banner" style="background:@color">
                <div class="nhaxe-logo-circle">
                    @(nx.TenNhaXe.Length > 0 ? nx.TenNhaXe[0].ToString().ToUpper() : "?")
                </div>
            </div>
            <div class="nhaxe-body">
                <h3 class="nhaxe-name">@nx.TenNhaXe</h3>
                <div class="nhaxe-meta">
                    @if (!string.IsNullOrEmpty(nx.Sdt))
                    { <span>📞 @nx.Sdt</span> }
                    @if (!string.IsNullOrEmpty(nx.Email))
                    { <span>✉️ @nx.Email</span> }
                    @if (!string.IsNullOrEmpty(nx.DiaChi))
                    { <span>📍 @nx.DiaChi</span> }
                </div>
                <div class="nhaxe-stats">
                    <div class="nhaxe-stat">
                        <div class="nhaxe-stat-val">@tongXe</div>
                        <div class="nhaxe-stat-lbl">Xe</div>
                    </div>
                    <div class="nhaxe-divider"></div>
                    <div class="nhaxe-stat">
                        <div class="nhaxe-stat-val">@tongChuyen</div>
                        <div class="nhaxe-stat-lbl">Chuyến</div>
                    </div>
                </div>
                <a asp-area="management" asp-controller="QuanLyNhaXe"
                   asp-action="ChiTiet" asp-route-maNhaXe="@nx.MaNhaXe"
                   class="btn btn-outline btn-sm btn-block-full">
                    Xem chi tiết →
                </a>
            </div>
        </div>
    }
    @if (!nhaXes.Any())
    {
        <div style="grid-column:1/-1;text-align:center;padding:60px;color:#94a3b8">
            <div style="font-size:3rem;margin-bottom:12px">🏢</div>
            <div>Không tìm thấy nhà xe nào.</div>
        </div>
    }
</div>
