@{
    ViewData["Title"] = "Báo cáo doanh thu";
    ViewData["AdminNav"] = "baocao";
    Layout = "~/Areas/Management/Views/Shared/_AdminLayout.cshtml";

    decimal totalRevenue = ViewBag.TotalRevenue ?? 0m;
    int totalTickets = ViewBag.TotalTickets ?? 0;
    int completedTrips = ViewBag.CompletedTrips ?? 0;
    double avgRating = ViewBag.AvgRating ?? 0.0;
    
    // Revenue by NhaXe is dynamic list of anonymous types, we can use dynamic or cast.
    var revenueByNhaXe = ViewBag.RevenueByNhaXe as IEnumerable<dynamic>;
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
  <div>
    <h2 style="font-size:1.3rem;font-weight:700;color:#1e293b;">📈 Báo cáo doanh thu</h2>
    <p style="color:#64748b;font-size:0.88rem;margin-top:4px;">Thống kê doanh thu theo thời gian</p>
  </div>
</div>

<!-- FILTER -->
<div style="background:white;border-radius:12px;padding:16px 20px;border:1px solid #f1f5f9;margin-bottom:24px;display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
  <div style="display:flex;align-items:center;gap:8px;">
    <span style="font-size:0.85rem;color:#64748b;font-weight:500;">Từ ngày:</span>
    <input type="date" class="form-control" style="width:auto;" value="2026-05-01" />
  </div>
  <div style="display:flex;align-items:center;gap:8px;">
    <span style="font-size:0.85rem;color:#64748b;font-weight:500;">Đến ngày:</span>
    <input type="date" class="form-control" style="width:auto;" value="2026-05-31" />
  </div>
  <select class="form-control" style="width:auto;">
    <option>Tháng này</option>
    <option>Tháng trước</option>
    <option>Quý này</option>
    <option>Năm nay</option>
  </select>
  <button class="admin-topbar-btn" style="background:#3b82f6;color:white;border-color:#3b82f6;">Xem báo cáo</button>
</div>

<!-- STAT CARDS -->
<div class="stat-cards">
  <div class="stat-card">
    <div class="stat-card-icon" style="background:#f0fdf4;color:#10b981;">💰</div>
    <div class="stat-card-value">@totalRevenue.ToString("N0")₫</div>
    <div class="stat-card-label">Tổng doanh thu</div>
    <div class="stat-card-trend trend-up">↑ Tăng trưởng tốt</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-icon" style="background:#eff6ff;color:#3b82f6;">🎫</div>
    <div class="stat-card-value">@totalTickets</div>
    <div class="stat-card-label">Tổng vé bán</div>
    <div class="stat-card-trend trend-up">↑ Tăng trưởng tốt</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-icon" style="background:#fef3c7;color:#f59e0b;">🚌</div>
    <div class="stat-card-value">@completedTrips</div>
    <div class="stat-card-label">Chuyến hoàn thành</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-icon" style="background:#fdf4ff;color:#9333ea;">⭐</div>
    <div class="stat-card-value">@avgRating.ToString("0.0") / 5</div>
    <div class="stat-card-label">Đánh giá trung bình</div>
  </div>
</div>

<!-- TABLE BÁO CÁO NHÀ XE -->
<div class="admin-table-wrap">
  <div class="admin-table-header">
    <h3>🏢 Doanh thu theo Nhà xe</h3>
    <button class="admin-topbar-btn">📥 Tải báo cáo chi tiết</button>
  </div>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Nhà xe</th>
        <th>Số chuyến</th>
        <th>Số vé bán</th>
        <th>Doanh thu</th>
        <th style="width:250px;">Tỷ lệ (%)</th>
      </tr>
    </thead>
    <tbody>
      @if(revenueByNhaXe != null)
      {
          foreach(var r in revenueByNhaXe)
          {
              <tr>
                  <td><strong>@r.TenNhaXe</strong></td>
                  <td>--</td>
                  <td>@r.SoVeBan</td>
                  <td>@((r.DoanhThu as decimal?)?.ToString("N0") ?? "0")₫</td>
                  <td>
                      <div style="display:flex;align-items:center;gap:8px;">
                          <div style="flex:1;height:6px;background:#e2e8f0;border-radius:3px;overflow:hidden;">
                              <div style="height:100%;width:@(((decimal)r.TyLe).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;background:#3b82f6;"></div>
                          </div>
                          <span style="font-size:0.85rem;color:#64748b;width:35px;text-align:right;">@(((decimal)r.TyLe).ToString("0.0"))%</span>
                      </div>
                  </td>
              </tr>
          }
      }
      else
      {
          <tr>
            <td colspan="5" style="text-align:center; padding:40px; color:#94a3b8;">Chưa có dữ liệu doanh thu.</td>
          </tr>
      }
    </tbody>
  </table>
</div>
