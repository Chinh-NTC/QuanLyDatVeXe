@{
    ViewData["Title"] = "Báo cáo doanh thu";
    ViewData["AdminNav"] = "baocao";
    Layout = "~/Areas/Management/Views/Shared/_AdminLayout.cshtml";
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
  <div>
    <h2 style="font-size:1.3rem;font-weight:700;color:#1e293b;">📈 Báo cáo doanh thu</h2>
    <p style="color:#64748b;font-size:0.88rem;margin-top:4px;">Thống kê doanh thu theo thời gian</p>
  </div>
</div>

<!-- FILTER -->
<div style="background:white;border-radius:12px;padding:16px 20px;border:1px solid #f1f5f9;margin-bottom:24px;display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
  <div style="display:flex;align-items:center;gap:8px;">
    <span style="font-size:0.85rem;color:#64748b;font-weight:500;">Từ ngày:</span>
    <input type="date" class="form-control" style="width:auto;" value="2026-05-01" />
  </div>
  <div style="display:flex;align-items:center;gap:8px;">
    <span style="font-size:0.85rem;color:#64748b;font-weight:500;">Đến ngày:</span>
    <input type="date" class="form-control" style="width:auto;" value="2026-05-31" />
  </div>
  <select class="form-control" style="width:auto;">
    <option>Tháng này</option>
    <option>Tháng trước</option>
    <option>Quý này</option>
    <option>Năm nay</option>
  </select>
  <button class="admin-topbar-btn" style="background:#3b82f6;color:white;border-color:#3b82f6;">Xem báo cáo</button>
</div>

<!-- STAT CARDS -->
<div class="stat-cards">
  <div class="stat-card">
    <div class="stat-card-icon" style="background:#f0fdf4;color:#10b981;">💰</div>
    <div class="stat-card-value">1.25 tỷ₫</div>
    <div class="stat-card-label">Tổng doanh thu</div>
    <div class="stat-card-trend trend-up">↑ 15% so với kỳ trước</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-icon" style="background:#eff6ff;color:#3b82f6;">🎫</div>
    <div class="stat-card-value">3,560</div>
    <div class="stat-card-label">Tổng vé bán</div>
    <div class="stat-card-trend trend-up">↑ 8% so với kỳ trước</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-icon" style="background:#fef3c7;color:#f59e0b;">🚌</div>
    <div class="stat-card-value">890</div>
    <div class="stat-card-label">Chuyến hoàn thành</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-icon" style="background:#fdf4ff;color:#9333ea;">⭐</div>
    <div class="stat-card-value">4.5</div>
    <div class="stat-card-label">Đánh giá trung bình</div>
  </div>
</div>

<!-- TABLE BÁO CÁO NHÀ XE -->
<div class="admin-table-wrap">
  <div class="admin-table-header">
    <h3>🏢 Doanh thu theo Nhà xe</h3>
    <button class="admin-topbar-btn">📥 Tải báo cáo chi tiết</button>
  </div>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Nhà xe</th>
        <th>Số chuyến</th>
        <th>Số vé bán</th>
        <th>Doanh thu</th>
        <th style="width:250px;">Tỷ lệ (%)</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>Phương Trang</strong></td>
        <td>320</td>
        <td>1,280</td>
        <td><strong style="color:#10b981;">480,000,000₫</strong></td>
        <td>
          <div style="display:flex;align-items:center;gap:10px;">
            <div style="flex:1;height:8px;background:#f1f5f9;border-radius:4px;overflow:hidden;">
              <div style="height:100%;background:#3b82f6;width:38.4%;"></div>
            </div>
            <span style="font-size:0.8rem;font-weight:600;color:#64748b;">38.4%</span>
          </div>
        </td>
      </tr>
      <tr>
        <td><strong>Thành Bưởi</strong></td>
        <td>240</td>
        <td>960</td>
        <td><strong style="color:#10b981;">320,000,000₫</strong></td>
        <td>
          <div style="display:flex;align-items:center;gap:10px;">
            <div style="flex:1;height:8px;background:#f1f5f9;border-radius:4px;overflow:hidden;">
              <div style="height:100%;background:#10b981;width:25.6%;"></div>
            </div>
            <span style="font-size:0.8rem;font-weight:600;color:#64748b;">25.6%</span>
          </div>
        </td>
      </tr>
      <tr>
        <td><strong>Hoàng Long</strong></td>
        <td>200</td>
        <td>800</td>
        <td><strong style="color:#10b981;">280,000,000₫</strong></td>
        <td>
          <div style="display:flex;align-items:center;gap:10px;">
            <div style="flex:1;height:8px;background:#f1f5f9;border-radius:4px;overflow:hidden;">
              <div style="height:100%;background:#f59e0b;width:22.4%;"></div>
            </div>
            <span style="font-size:0.8rem;font-weight:600;color:#64748b;">22.4%</span>
          </div>
        </td>
      </tr>
      <tr>
        <td><strong>Kumho Samco</strong></td>
        <td>130</td>
        <td>520</td>
        <td><strong style="color:#10b981;">170,000,000₫</strong></td>
        <td>
          <div style="display:flex;align-items:center;gap:10px;">
            <div style="flex:1;height:8px;background:#f1f5f9;border-radius:4px;overflow:hidden;">
              <div style="height:100%;background:#9333ea;width:13.6%;"></div>
            </div>
            <span style="font-size:0.8rem;font-weight:600;color:#64748b;">13.6%</span>
          </div>
        </td>
      </tr>
    </tbody>
  </table>
</div>
