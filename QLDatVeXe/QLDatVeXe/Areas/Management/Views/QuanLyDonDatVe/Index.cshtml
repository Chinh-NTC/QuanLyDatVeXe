@{
    ViewData["Title"] = "Quản lý Đơn đặt vé";
    ViewData["AdminNav"] = "dondatve";
    Layout = "~/Areas/Management/Views/Shared/_AdminLayout.cshtml";
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
  <div>
    <h2 style="font-size:1.3rem;font-weight:700;color:#1e293b;">🎫 Danh sách Đơn đặt vé</h2>
    <p style="color:#64748b;font-size:0.88rem;margin-top:4px;">Quản lý tất cả đơn đặt vé của khách hàng</p>
  </div>
  <button class="admin-topbar-btn">📥 Xuất Excel</button>
</div>

<!-- STAT MINI -->
<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:20px;">
  <div style="background:white;border-radius:12px;padding:16px;border:1px solid #f1f5f9;text-align:center;">
    <div style="font-size:1.5rem;font-weight:800;color:#3b82f6;">1,248</div>
    <div style="font-size:0.8rem;color:#64748b;margin-top:4px;">Tổng đơn</div>
  </div>
  <div style="background:white;border-radius:12px;padding:16px;border:1px solid #f1f5f9;text-align:center;">
    <div style="font-size:1.5rem;font-weight:800;color:#f59e0b;">45</div>
    <div style="font-size:0.8rem;color:#64748b;margin-top:4px;">Chờ xử lý</div>
  </div>
  <div style="background:white;border-radius:12px;padding:16px;border:1px solid #f1f5f9;text-align:center;">
    <div style="font-size:1.5rem;font-weight:800;color:#10b981;">1,150</div>
    <div style="font-size:0.8rem;color:#64748b;margin-top:4px;">Đã xác nhận</div>
  </div>
  <div style="background:white;border-radius:12px;padding:16px;border:1px solid #f1f5f9;text-align:center;">
    <div style="font-size:1.5rem;font-weight:800;color:#ef4444;">53</div>
    <div style="font-size:0.8rem;color:#64748b;margin-top:4px;">Đã hủy</div>
  </div>
</div>

<!-- FILTER -->
<div style="background:white;border-radius:12px;padding:16px 20px;border:1px solid #f1f5f9;margin-bottom:20px;display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
  <select class="form-control" style="width:auto;">
    <option>Tất cả trạng thái</option>
    <option>Chờ xử lý</option>
    <option>Đã xác nhận</option>
    <option>Hoàn thành</option>
    <option>Đã hủy</option>
  </select>
  <input type="date" class="form-control" style="width:auto;" />
  <input type="text" class="form-control" style="flex:1;min-width:200px;" placeholder="🔍 Tìm mã đơn, tên khách..." />
  <button class="admin-topbar-btn">Lọc</button>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Mã đơn</th>
        <th>Khách hàng</th>
        <th>SĐT</th>
        <th>Tuyến đường</th>
        <th>Ngày đặt</th>
        <th>Ghế</th>
        <th>Tổng tiền</th>
        <th>Thanh toán</th>
        <th>Trạng thái</th>
        <th>Thao tác</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><strong style="color:#3b82f6">#DV001</strong></td>
        <td>Nguyễn Văn A</td>
        <td>0912345678</td>
        <td>Hà Nội → TP. HCM</td>
        <td>25/05/2026</td>
        <td><span class="badge badge-info">A3, A7</span></td>
        <td><strong>700.000₫</strong></td>
        <td><span class="badge badge-success">Đã TT</span></td>
        <td><span class="badge badge-success">Đã xác nhận</span></td>
        <td><button class="admin-topbar-btn" style="font-size:0.78rem;padding:4px 10px;">Chi tiết</button></td>
      </tr>
      <tr>
        <td><strong style="color:#3b82f6">#DV002</strong></td>
        <td>Trần Thị B</td>
        <td>0987654321</td>
        <td>TP. HCM → Đà Lạt</td>
        <td>25/05/2026</td>
        <td><span class="badge badge-info">B5</span></td>
        <td><strong>180.000₫</strong></td>
        <td><span class="badge badge-warning">Chưa TT</span></td>
        <td><span class="badge badge-warning">Chờ xử lý</span></td>
        <td>
          <button class="admin-topbar-btn" style="font-size:0.78rem;padding:4px 10px;margin-right:4px;background:#10b981;color:white;border-color:#10b981;">Xác nhận</button>
          <button class="admin-topbar-btn" style="font-size:0.78rem;padding:4px 10px;color:#ef4444;border-color:#fca5a5;">Hủy</button>
        </td>
      </tr>
      <tr>
        <td><strong style="color:#3b82f6">#DV003</strong></td>
        <td>Lê Văn C</td>
        <td>0901234567</td>
        <td>Đà Nẵng → Hội An</td>
        <td>24/05/2026</td>
        <td><span class="badge badge-info">A1</span></td>
        <td><strong>120.000₫</strong></td>
        <td><span class="badge badge-success">Đã TT</span></td>
        <td><span class="badge badge-gray">Hoàn thành</span></td>
        <td><button class="admin-topbar-btn" style="font-size:0.78rem;padding:4px 10px;">Chi tiết</button></td>
      </tr>
      <tr>
        <td><strong style="color:#3b82f6">#DV004</strong></td>
        <td>Phạm Thị D</td>
        <td>0976543210</td>
        <td>Hà Nội → Vinh</td>
        <td>24/05/2026</td>
        <td><span class="badge badge-danger" style="text-decoration:line-through;">B3</span></td>
        <td><strong>220.000₫</strong></td>
        <td><span class="badge badge-danger">Chưa TT</span></td>
        <td><span class="badge badge-danger">Đã hủy</span></td>
        <td><button class="admin-topbar-btn" style="font-size:0.78rem;padding:4px 10px;">Chi tiết</button></td>
      </tr>
      <tr>
        <td><strong style="color:#3b82f6">#DV005</strong></td>
        <td>Hoàng Văn E</td>
        <td>0938765432</td>
        <td>TP. HCM → Cần Thơ</td>
        <td>23/05/2026</td>
        <td><span class="badge badge-info">A2, A6</span></td>
        <td><strong>300.000₫</strong></td>
        <td><span class="badge badge-success">Đã TT</span></td>
        <td><span class="badge badge-success">Đã xác nhận</span></td>
        <td><button class="admin-topbar-btn" style="font-size:0.78rem;padding:4px 10px;">Chi tiết</button></td>
      </tr>
    </tbody>
  </table>
</div>
