@using QLDatVeXe.Helpers
@using QLDatVeXe.Domain.Enums
@{
    var currentUser = SessionHelper.GetCurrentUser(Context.Session);
    var vaiTro      = currentUser?.VaiTro;
    var pageTitle   = ViewBag.Title    as string ?? "Quản lý — BusGo";
    var pageName    = ViewBag.PageName as string ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@pageTitle</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true"/>
</head>
<body>

<div class="admin-layout">
    <!-- SIDEBAR -->
    <nav class="sidebar">
        <div class="sidebar-logo">
            <span>🚌</span> <span>BusGo</span>
        </div>
        <div class="sidebar-role">Quản lý hệ thống</div>

        <div class="sidebar-nav">
            <div class="nav-section">Tổng quan</div>
            <a asp-area="management" asp-controller="Dashboard" asp-action="Index"
               class="nav-item @(pageName == "Dashboard" ? "active" : "")">
                <span class="icon">📊</span> Thống kê
            </a>

            <div class="nav-section" style="margin-top:8px">Quản lý</div>
            <a asp-area="management" asp-controller="QuanLyKhachHang" asp-action="Index"
               class="nav-item @(pageName == "KhachHang" ? "active" : "")">
                <span class="icon">👥</span> Khách hàng
            </a>
            <a asp-area="management" asp-controller="QuanLyNhaXe" asp-action="Index"
               class="nav-item @(pageName == "NhaXe" ? "active" : "")">
                <span class="icon">🏢</span> Nhà xe
            </a>
            <a asp-area="management" asp-controller="QuanLyChuyenXe" asp-action="Index"
               class="nav-item @(pageName == "ChuyenXe" ? "active" : "")">
                <span class="icon">🚌</span> Chuyến xe
            </a>
            <a asp-area="management" asp-controller="QuanLyDonHang" asp-action="Index"
               class="nav-item @(pageName == "DonHang" ? "active" : "")">
                <span class="icon">📋</span> Đơn hàng
            </a>
            <a asp-area="management" asp-controller="QuanLyNhanVien" asp-action="Index"
               class="nav-item @(pageName == "NhanVien" ? "active" : "")">
                <span class="icon">👔</span> Nhân viên
            </a>
        </div>

        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="sidebar-avatar">@(currentUser?.HoTen?.Length > 0 ? currentUser.HoTen[0].ToString().ToUpper() : "A")</div>
                <div>
                    <div class="user-name">@(currentUser?.HoTen ?? "Admin")</div>
                    <div class="user-role">Quản lý</div>
                </div>
            </div>
            <form asp-area="" asp-controller="TaiKhoan" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-ghost btn-sm" style="color:#94a3b8;width:100%;margin-top:8px">
                    🚪 Đăng xuất
                </button>
            </form>
        </div>
    </nav>

    <!-- MAIN -->
    <main class="admin-main">
        <div class="admin-header">
            <div>
                <h1 class="admin-page-title">
                    @(pageName switch {
                        "Dashboard"  => "📊 Thống kê tổng quan",
                        "KhachHang"  => "👥 Quản lý Khách hàng",
                        "NhaXe"      => "🏢 Quản lý Nhà xe",
                        "ChuyenXe"   => "🚌 Quản lý Chuyến xe",
                        "DonHang"    => "📋 Quản lý Đơn hàng",
                        "NhanVien"   => "👔 Quản lý Nhân viên",
                        _            => pageTitle
                    })
                </h1>
            </div>
            <div style="font-size:.8rem;color:#94a3b8">
                @DateTime.Now.ToString("HH:mm — dd/MM/yyyy")
            </div>
        </div>

        <div class="admin-content">
            @if (TempData["Success"] is string msg)
            {
                <div class="alert alert-success" data-autodismiss>✅ @msg</div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger" data-autodismiss>⚠️ @err</div>
            }
            @RenderBody()
        </div>
    </main>
</div>

<div id="toast-container" class="toast-container"></div>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
