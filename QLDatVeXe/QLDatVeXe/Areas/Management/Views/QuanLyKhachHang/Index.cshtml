@{
    Layout = "~/Areas/Management/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Khách hàng";
    ViewData["AdminNav"] = "khachhang";
}

<!-- Title Bar -->
<div style="margin-bottom: 28px;">
    <h2 style="font-size: 2rem; font-weight: 800; margin-bottom: 6px; letter-spacing: -0.5px;">👥 Danh sách Khách hàng</h2>
    <p style="color: #7a8a9e; font-size: 1.05rem; margin: 0;">Quản lý thông tin khách hàng trong hệ thống</p>
</div>

<!-- Filter Bar -->
<div style="display: flex; align-items: center; gap: 14px; margin-bottom: 22px; flex-wrap: wrap;">
    <input type="text" placeholder="🔍 Tìm tên, SĐT, tên đăng nhập..."
           style="flex: 1 1 280px; min-width: 200px; padding: 10px 16px; border: 1.5px solid #e0e5ec; border-radius: 9px; font-size: 1rem; background: #f8fafc; outline: none; transition: border 0.2s;"
           onfocus="this.style.borderColor='#2563eb'" onblur="this.style.borderColor='#e0e5ec'" />

    <select style="padding: 10px 18px; border: 1.5px solid #e0e5ec; border-radius: 9px; font-size: 1rem; background: #f8fafc; outline: none; min-width: 140px; cursor: pointer;">
        <option value="">Tất cả</option>
        <option value="Nam">Nam</option>
        <option value="Nữ">Nữ</option>
    </select>

    <button class="admin-topbar-btn" style="padding: 10px 28px; font-size: 1rem; border-radius: 9px; font-weight: 600;">
        🔎 Lọc
    </button>
</div>

