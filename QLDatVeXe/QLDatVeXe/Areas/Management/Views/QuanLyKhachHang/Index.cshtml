@{
    ViewBag.Title    = "Quản lý Khách hàng";
    ViewBag.PageName = "KhachHang";

    var khachHangs = ViewBag.KhachHangs as List<QLDatVeXe.Models.Khachhang> ?? new();
    var page       = (int)(ViewBag.Page       ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var total      = (int)(ViewBag.Total      ?? 0);
    var search     = ViewBag.Search    as string ?? "";
    var trangThai  = ViewBag.TrangThai as string ?? "";
}

<!-- Toolbar -->
<div class="toolbar">
    <form method="get" class="toolbar-search">
        <div class="search-box">
            <span class="search-icon">🔍</span>
            <input type="text" name="search" value="@search"
                   placeholder="Tìm theo tên, SĐT, tên đăng nhập…"
                   class="search-input" />
        </div>
        <select name="trangThai" class="filter-select" onchange="this.form.submit()">
            <option value="">— Tất cả trạng thái —</option>
            <option value="active"   selected="@(trangThai=="active"   ? "selected" : null)">Đang hoạt động</option>
            <option value="inactive" selected="@(trangThai=="inactive" ? "selected" : null)">Đã khóa</option>
        </select>
        <button type="submit" class="btn btn-primary btn-sm">Lọc</button>
        @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(trangThai))
        {
            <a href="@Url.Action("Index")" class="btn btn-ghost btn-sm">✕ Xóa lọc</a>
        }
    </form>
    <div class="toolbar-stats">
        <span class="stat-badge">Tổng: <b>@total</b> khách</span>
    </div>
</div>

<!-- Table -->
<div class="panel">
    <div class="panel-body table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Khách hàng</th>
                    <th>Tên đăng nhập</th>
                    <th>Số điện thoại</th>
                    <th>Giới tính</th>
                    <th>Ngày tạo</th>
                    <th>Số đơn</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @{int stt = (page - 1) * 10 + 1;}
                @foreach (var kh in khachHangs)
                {
                    var isActive = kh.Trangthai;
                    <tr>
                        <td style="color:#94a3b8;font-size:.82rem">@(stt++)</td>
                        <td>
                            <div class="user-cell">
                                <div class="user-avatar" style="background:@(isActive ? "linear-gradient(135deg,#2563eb,#7c3aed)" : "#94a3b8")">
                                    @(kh.HoTen.Length > 0 ? kh.HoTen[0].ToString().ToUpper() : "?")
                                </div>
                                <div>
                                    <div style="font-weight:600">@kh.HoTen</div>
                                    <div style="font-size:.75rem;color:#94a3b8">@kh.MaKh</div>
                                </div>
                            </div>
                        </td>
                        <td style="font-size:.88rem;color:#475569">@kh.TenDangNhap</td>
                        <td style="font-size:.88rem">@kh.Sdt</td>
                        <td>
                            @if (kh.GioiTinh == true)
                            { <span class="badge" style="background:#dbeafe;color:#1d4ed8">♂ Nam</span> }
                            else if (kh.GioiTinh == false)
                            { <span class="badge" style="background:#fce7f3;color:#be185d">♀ Nữ</span> }
                            else
                            { <span style="color:#94a3b8">—</span> }
                        </td>
                        <td style="color:#64748b;font-size:.82rem">@kh.NgayTao?.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge badge-blue">@kh.Dondatve.Count đơn</span>
                        </td>
                        <td>
                            @if (isActive)
                            { <span class="badge badge-green">● Hoạt động</span> }
                            else
                            { <span class="badge badge-red">⊗ Đã khóa</span> }
                        </td>
                        <td>
                            <form asp-area="management" asp-controller="QuanLyKhachHang"
                                  asp-action="DoiTrangThai" method="post"
                                  style="display:inline"
                                  onsubmit="return confirm('@(isActive ? "Khóa tài khoản " + kh.HoTen + "?" : "Mở khóa tài khoản " + kh.HoTen + "?")')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maKH" value="@kh.MaKh" />
                                <button type="submit"
                                        class="btn btn-sm @(isActive ? "btn-danger-soft" : "btn-success-soft")">
                                    @(isActive ? "🔒 Khóa" : "🔓 Mở khóa")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!khachHangs.Any())
                {
                    <tr>
                        <td colspan="9" style="text-align:center;padding:40px;color:#94a3b8">
                            <div style="font-size:2rem;margin-bottom:8px">👥</div>
                            Không tìm thấy khách hàng nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
@if (totalPages > 1)
{
    <div class="pagination">
        @if (page > 1)
        {
            <a href="?page=@(page-1)&search=@search&trangThai=@trangThai" class="page-btn">← Trước</a>
        }
        @for (int i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
        {
            <a href="?page=@i&search=@search&trangThai=@trangThai"
               class="page-btn @(i == page ? "active" : "")">@i</a>
        }
        @if (page < totalPages)
        {
            <a href="?page=@(page+1)&search=@search&trangThai=@trangThai" class="page-btn">Sau →</a>
        }
    </div>
}
