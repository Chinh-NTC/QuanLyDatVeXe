@model QLDatVeXe.Models.Dondatve
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    ViewBag.PageName = "DonHang";
}

<div style="margin-bottom:16px">
    <a asp-action="Index" class="btn btn-ghost btn-sm">← Quay lại</a>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
    <div class="panel">
        <div class="panel-header"><h3>📋 Thông tin đơn hàng</h3></div>
        <div class="card-body">
            <table style="border:none">
                <tr><td style="color:var(--gray-500);width:140px">Mã đơn</td><td><strong>@Model.MaDon</strong></td></tr>
                <tr><td style="color:var(--gray-500)">Khách hàng</td><td>@(Model.MaKhNavigation?.HoTen ?? Model.MaKh)</td></tr>
                <tr><td style="color:var(--gray-500)">Người đi</td><td><strong>@Model.Tennguoidi</strong></td></tr>
                <tr><td style="color:var(--gray-500)">SĐT người đi</td><td>@Model.Sdtnguoidi</td></tr>
                <tr><td style="color:var(--gray-500)">Ghi chú</td><td>@(Model.GhiChu ?? "—")</td></tr>
                <tr><td style="color:var(--gray-500)">Ngày đặt</td><td>@Model.NgayDat?.ToString("dd/MM/yyyy HH:mm")</td></tr>
                <tr><td style="color:var(--gray-500)">Tổng tiền</td><td style="font-weight:800;color:var(--primary);font-size:1.1rem">@Model.TongTien?.ToString("N0")₫</td></tr>
                <tr><td style="color:var(--gray-500)">Trạng thái</td>
                    <td>@{
                        var badge = Model.TrangThai switch { "THANHCONG"=>"badge-green","CHOXULY"=>"badge-yellow","DAHUY"=>"badge-red",_=>"badge-gray" };
                    }<span class="badge @badge">@Model.TrangThai</span></td></tr>
            </table>
        </div>
    </div>

    <div class="panel">
        <div class="panel-header"><h3>💳 Thanh toán</h3></div>
        <div class="card-body">
            @foreach (var tt in Model.Thanhtoan)
            {
                <table style="border:none">
                    <tr><td style="color:var(--gray-500);width:140px">Mã TT</td><td>@tt.MaTt</td></tr>
                    <tr><td style="color:var(--gray-500)">Phương thức</td><td>@tt.PhuongThuc</td></tr>
                    <tr><td style="color:var(--gray-500)">Số tiền</td><td style="font-weight:700">@tt.SoTien.ToString("N0")₫</td></tr>
                    <tr><td style="color:var(--gray-500)">Thời gian TT</td><td>@tt.ThoiGianTt?.ToString("dd/MM/yyyy HH:mm")</td></tr>
                    <tr><td style="color:var(--gray-500)">Trạng thái</td><td>@tt.TrangThai</td></tr>
                </table>
            }
        </div>
    </div>
</div>

<div class="panel" style="margin-top:20px">
    <div class="panel-header"><h3>🪑 Chi tiết vé</h3></div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Mã CT</th><th>Mã chuyến</th><th>Mã ghế</th><th>Giá lúc đặt</th><th>Trạng thái</th></tr></thead>
            <tbody>
                @foreach (var ct in Model.Chitietdatve)
                {
                    <tr>
                        <td>@ct.MaCtdat</td>
                        <td>@ct.MaChuyen</td>
                        <td><span class="badge badge-blue">@ct.MaGhe</span></td>
                        <td>@ct.GiaVeLucDat.ToString("N0")₫</td>
                        <td><span class="badge @(ct.TrangThaiVe == "DADAT" ? "badge-green" : "badge-red")">@ct.TrangThaiVe</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
