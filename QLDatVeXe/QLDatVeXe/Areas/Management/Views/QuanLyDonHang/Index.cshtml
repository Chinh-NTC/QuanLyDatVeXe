@model List<QLDatVeXe.Models.Dondatve>
@{
    ViewBag.Title = "Quản lý đơn hàng";
    ViewBag.PageName = "DonHang";
    var filterTT = ViewBag.TrangThai as string ?? "";
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
    <h2 style="font-size:1.2rem;font-weight:700">Danh sách đơn hàng (@Model.Count)</h2>
</div>

<div class="panel">
    <div class="filter-bar">
        <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(filterTT) ? "btn-primary" : "btn-ghost")">Tất cả</a>
        <a asp-action="Index" asp-route-trangThai="CHOXULY"   class="btn btn-sm @(filterTT=="CHOXULY"?"btn-primary":"btn-ghost")">⏳ Chờ xử lý</a>
        <a asp-action="Index" asp-route-trangThai="THANHCONG" class="btn btn-sm @(filterTT=="THANHCONG"?"btn-primary":"btn-ghost")">✅ Thành công</a>
        <a asp-action="Index" asp-route-trangThai="DAHUY"     class="btn btn-sm @(filterTT=="DAHUY"?"btn-primary":"btn-ghost")">❌ Đã hủy</a>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Người đi</th>
                    <th>Số ghế</th>
                    <th>Tổng tiền</th>
                    <th>Ngày đặt</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    var badge = d.TrangThai switch {
                        "THANHCONG" => "badge-green",
                        "CHOXULY"   => "badge-yellow",
                        "DAHUY"     => "badge-red",
                        _ => "badge-gray"
                    };
                    <tr>
                        <td><span class="badge badge-blue">@d.MaDon</span></td>
                        <td>
                            <div style="font-weight:600">@(d.MaKhNavigation?.HoTen ?? "—")</div>
                            <div style="font-size:.75rem;color:var(--gray-400)">@d.MaKh</div>
                        </td>
                        <td>
                            <div>@d.Tennguoidi</div>
                            <div style="font-size:.75rem;color:var(--gray-400)">@d.Sdtnguoidi</div>
                        </td>
                        <td>@d.Chitietdatve.Count ghế</td>
                        <td style="font-weight:700;color:var(--primary)">@d.TongTien?.ToString("N0")₫</td>
                        <td>@d.NgayDat?.ToString("dd/MM/yy HH:mm")</td>
                        <td><span class="badge @badge">@d.TrangThai</span></td>
                        <td>
                            <div style="display:flex;gap:6px">
                                <a asp-action="ChiTiet" asp-route-maDon="@d.MaDon" class="btn btn-outline btn-sm">👁</a>
                                @if (d.TrangThai == "CHOXULY")
                                {
                                    <form asp-action="DuyetDon" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="maDon" value="@d.MaDon"/>
                                        <button type="submit" class="btn btn-success btn-sm" title="Duyệt">✅</button>
                                    </form>
                                    <form asp-action="HuyDon" method="post" style="display:inline"
                                          onsubmit="return confirm('Hủy đơn @d.MaDon?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="maDon" value="@d.MaDon"/>
                                        <button type="submit" class="btn btn-danger btn-sm" title="Hủy">❌</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
