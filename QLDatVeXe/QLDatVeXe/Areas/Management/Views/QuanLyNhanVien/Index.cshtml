@model List<QLDatVeXe.Models.Nhanvien>
@{
    ViewBag.Title = "Quản lý nhân viên";
    ViewBag.PageName = "Nhân viên";
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
    <h2 style="font-size:1.2rem;font-weight:700">Danh sách nhân viên (@Model.Count)</h2>
    <button class="btn btn-primary" onclick="openModal('modal-them-nv')">+ Thêm nhân viên</button>
</div>

<div class="panel">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Mã NV</th>
                    <th>Họ tên</th>
                    <th>Tên đăng nhập</th>
                    <th>Chức vụ</th>
                    <th>SĐT</th>
                    <th>Lương</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var nv in Model)
                {
                    <tr>
                        <td><span class="badge badge-gray">@nv.MaNv</span></td>
                        <td style="font-weight:600">@nv.HoTen</td>
                        <td>@nv.TenDangNhap</td>
                        <td>@nv.ChucVu</td>
                        <td>@nv.Sdt</td>
                        <td>@nv.Luong?.ToString("N0")₫</td>
                        <td>
                            <span class="badge @(nv.TrangThai=="DANGLAM"?"badge-green":"badge-red")">@nv.TrangThai</span>
                        </td>
                        <td>
                            <div style="display:flex;gap:6px">
                                <button class="btn btn-outline btn-sm"
                                        onclick='editNV(@System.Text.Json.JsonSerializer.Serialize(new{nv.MaNv,nv.HoTen,nv.Sdt,nv.Email,nv.DiaChi,nv.ChucVu,luong=(double?)nv.Luong,nv.TrangThai}))'>✏️ Sửa</button>
                                @if (nv.TrangThai == "DANGLAM")
                                {
                                    <form asp-action="Xoa" method="post" style="display:inline"
                                          onsubmit="return confirm('Đặt nhân viên @nv.HoTen sang trạng thái nghỉ việc?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="maNV" value="@nv.MaNv"/>
                                        <button type="submit" class="btn btn-danger btn-sm">🔴 Nghỉ việc</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm NV -->
<div class="modal-overlay" id="modal-them-nv">
    <div class="modal" style="max-width:540px">
        <div class="modal-header">
            <h3>➕ Thêm nhân viên mới</h3>
            <button class="modal-close" onclick="closeModal('modal-them-nv')">✕</button>
        </div>
        <form asp-action="Them" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body" style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
                <div class="form-group" style="grid-column:1/-1">
                    <label class="form-label">Họ và tên <span style="color:var(--danger)">*</span></label>
                    <input type="text" class="form-control" name="HoTen" required placeholder="Nguyễn Văn A"/>
                </div>
                <div class="form-group">
                    <label class="form-label">Tên đăng nhập <span style="color:var(--danger)">*</span></label>
                    <input type="text" class="form-control" name="TenDangNhap" required/>
                </div>
                <div class="form-group">
                    <label class="form-label">Mật khẩu <span style="color:var(--danger)">*</span></label>
                    <input type="text" class="form-control" name="matKhauMoi" required placeholder="Mật khẩu ban đầu"/>
                </div>
                <div class="form-group">
                    <label class="form-label">Chức vụ</label>
                    <select class="form-control" name="ChucVu">
                        <option value="Bán vé">Bán vé</option>
                        <option value="Quản lý">Quản lý</option>
                        <option value="Hỗ trợ">Hỗ trợ</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Số điện thoại</label>
                    <input type="tel" class="form-control" name="Sdt" placeholder="09xxxxxxxx"/>
                </div>
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" name="Email"/>
                </div>
                <div class="form-group" style="grid-column:1/-1">
                    <label class="form-label">Địa chỉ</label>
                    <input type="text" class="form-control" name="DiaChi"/>
                </div>
                <div class="form-group">
                    <label class="form-label">Lương (VNĐ/tháng)</label>
                    <input type="number" class="form-control" name="Luong" min="0" step="100000"/>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal('modal-them-nv')">Hủy</button>
                <button type="submit" class="btn btn-primary">Thêm nhân viên</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Sửa NV -->
<div class="modal-overlay" id="modal-sua-nv">
    <div class="modal" style="max-width:540px">
        <div class="modal-header">
            <h3>✏️ Sửa thông tin nhân viên</h3>
            <button class="modal-close" onclick="closeModal('modal-sua-nv')">✕</button>
        </div>
        <form asp-action="Sua" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="MaNv" id="sua-maNV"/>
            <div class="modal-body" style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
                <div class="form-group" style="grid-column:1/-1">
                    <label class="form-label">Họ và tên</label>
                    <input type="text" class="form-control" name="HoTen" id="sua-nv-hoTen" required/>
                </div>
                <div class="form-group">
                    <label class="form-label">Chức vụ</label>
                    <select class="form-control" name="ChucVu" id="sua-nv-chucVu">
                        <option value="Bán vé">Bán vé</option>
                        <option value="Quản lý">Quản lý</option>
                        <option value="Hỗ trợ">Hỗ trợ</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">SĐT</label>
                    <input type="tel" class="form-control" name="Sdt" id="sua-nv-sdt"/>
                </div>
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" name="Email" id="sua-nv-email"/>
                </div>
                <div class="form-group">
                    <label class="form-label">Lương</label>
                    <input type="number" class="form-control" name="Luong" id="sua-nv-luong" min="0" step="100000"/>
                </div>
                <div class="form-group">
                    <label class="form-label">Trạng thái</label>
                    <select class="form-control" name="TrangThai" id="sua-nv-tt">
                        <option value="DANGLAM">DANGLAM</option>
                        <option value="NGHIVIEC">NGHIVIEC</option>
                    </select>
                </div>
                <div class="form-group" style="grid-column:1/-1">
                    <label class="form-label">Mật khẩu mới (bỏ trống = giữ nguyên)</label>
                    <input type="text" class="form-control" name="matKhauMoi" placeholder="Để trống nếu không đổi"/>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal('modal-sua-nv')">Hủy</button>
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function editNV(data) {
    document.getElementById('sua-maNV').value       = data.maNv;
    document.getElementById('sua-nv-hoTen').value   = data.hoTen;
    document.getElementById('sua-nv-sdt').value     = data.sdt || '';
    document.getElementById('sua-nv-email').value   = data.email || '';
    document.getElementById('sua-nv-luong').value   = data.luong || '';
    document.getElementById('sua-nv-chucVu').value  = data.chucVu || '';
    document.getElementById('sua-nv-tt').value      = data.trangThai || 'DANGLAM';
    openModal('modal-sua-nv');
}
</script>
}
