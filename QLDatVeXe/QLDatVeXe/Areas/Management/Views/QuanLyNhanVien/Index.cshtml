@{
    ViewBag.Title    = "Trang chủ Nhân viên";
    ViewBag.PageName = "NVHome";
    var dsTinh       = ViewBag.DsTinh as List<QLDatVeXe.Models.Tinhthanh> ?? new();
    var tongDonHomNay = (int)(ViewBag.TongDonHomNay ?? 0);
    var chuyenHomNay  = (int)(ViewBag.ChuyenHomNay  ?? 0);
    var donHomNay     = ViewBag.DonHomNay as List<QLDatVeXe.Models.Dondatve> ?? new();
    var locTrangThai  = ViewBag.LocTrangThai as string ?? "";
    var chuyenHomNayList = ViewBag.ChuyenHomNayList as List<QLDatVeXe.Models.VChuyenxe> ?? new();
    var locTrangThaiChuyen = ViewBag.LocTrangThaiChuyen as string ?? "";
    var maTinhDi = ViewBag.MaTinhDi as string ?? "";
    var maTinhDen = ViewBag.MaTinhDen as string ?? "";
}

<style>
    .admin-layout { height: 100vh; overflow: hidden; }
    .admin-main { display: flex; flex-direction: column; height: 100vh; }
    .admin-content { flex: 1; display: flex; flex-direction: column; overflow: hidden; padding-bottom: 24px; }
    
    /* Thu nhỏ thẻ KPI */
    .kpi-grid { margin-bottom: 16px; }
    .kpi-card { padding: 12px 16px; border-radius: 12px; }
    .kpi-icon { font-size: 1.4rem; }
    .kpi-value { font-size: 1.3rem; }
    .kpi-label { font-size: 0.72rem; }

    /* Split panels 50/50 */
    .dashboard-split {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-height: 0;
    }
    .dashboard-split > .panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        margin-bottom: 0;
        min-height: 0;
    }
    .dashboard-split > .panel > .panel-body {
        flex: 1;
        overflow-y: auto;
        padding: 0; /* Remove extra padding for table wrap */
    }
    .form-panel-body {
        padding: 16px 24px !important;
    .dashboard-split > .panel > .panel-header {
        padding: 8px 16px !important;
    }
</style>

<div class="kpi-grid" style="grid-template-columns:repeat(2,1fr)">
    <div class="kpi-card kpi-blue">
        <div class="kpi-icon">🚌</div>
        <div class="kpi-info">
            <div class="kpi-value">@chuyenHomNay</div>
            <div class="kpi-label">Chuyến xe hôm nay</div>
        </div>
    </div>
    <div class="kpi-card kpi-green">
        <div class="kpi-icon">🎫</div>
        <div class="kpi-info">
            <div class="kpi-value">@tongDonHomNay</div>
            <div class="kpi-label">Đơn đặt hôm nay</div>
        </div>
    </div>
</div>

<div class="dashboard-split">
<!-- Đơn đặt vé hôm nay -->
<div class="panel">
    <div class="panel-header" style="display:flex; justify-content:space-between; align-items:center; padding: 10px 20px;">
        <h3>📋 Đơn đặt vé hôm nay</h3>
        <form method="get" style="display:flex; gap:10px; align-items:center; margin:0">
            <input type="hidden" name="locTrangThaiChuyen" value="@locTrangThaiChuyen" />
            <span style="font-size:0.8rem; color:#64748b">Lọc trạng thái:</span>
            <select name="locTrangThai" class="form-control" onchange="this.form.submit()" style="padding:4px 12px; font-size:0.85rem; border-radius:6px; height:auto">
                <option value="">-- Tất cả --</option>
                <option value="THANHCONG" selected="@(locTrangThai == "THANHCONG" ? "selected" : null)">🟢 Hoàn thành</option>
                <option value="CHOTHANHTOAN" selected="@(locTrangThai == "CHOTHANHTOAN" ? "selected" : null)">🔵 Đang xử lý</option>
                <option value="DAHUY" selected="@(locTrangThai == "DAHUY" ? "selected" : null)">🔴 Đã hủy</option>
            </select>
        </form>
    </div>
    <div class="panel-body table-wrap">
        @if (donHomNay.Any())
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Chuyến xe (Ghế)</th>
                        <th>Giờ đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in donHomNay)
                    {
                        var firstCT = d.Chitietdatve.FirstOrDefault();
                        var chuyen = firstCT?.MaChuyen ?? "—";
                        var dsghe = string.Join(", ", d.Chitietdatve.Select(ct => ct.MaGhe));
                        
                        <tr>
                            <td style="font-weight:700;color:#1e293b">@d.MaDon</td>
                            <td>
                                <div class="user-cell">
                                    <div class="user-avatar" style="background:linear-gradient(135deg,#059669,#10b981);width:32px;height:32px;font-size:.8rem">
                                        @(d.MaKhNavigation?.HoTen?.FirstOrDefault().ToString().ToUpper() ?? "?")
                                    </div>
                                    <div style="font-weight:600">@(d.MaKhNavigation?.HoTen ?? "Khách lẻ")</div>
                                </div>
                            </td>
                            <td>
                                <div style="font-weight:600;color:#2563eb">Mã: @chuyen</div>
                                <div style="font-size:.75rem;color:#64748b">Ghế: @(string.IsNullOrEmpty(dsghe) ? "—" : dsghe)</div>
                            </td>
                            <td style="color:#64748b;font-weight:500">@d.NgayDat?.ToString("HH:mm")</td>
                            <td style="font-weight:700;color:#059669">@d.TongTien?.ToString("N0")₫</td>
                            <td>
                                @if (d.TrangThai == "THANHCONG") { <span class="badge badge-green">Hoàn thành</span> }
                                else if (d.TrangThai == "CHOTHANHTOAN") { <span class="badge badge-blue">Đang xử lý</span> }
                                else if (d.TrangThai == "DAHUY") { <span class="badge badge-red">Đã hủy</span> }
                                else { <span class="badge">@d.TrangThai</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div style="padding:30px; text-align:center; color:#94a3b8">
                <div style="font-size:2rem; margin-bottom:10px">📭</div>
                Không có đơn đặt vé nào phù hợp.
            </div>
        }
    </div>
</div>

<!-- Bảng các chuyến hôm nay -->
<div class="panel">
    <div class="panel-header" style="display:flex; justify-content:space-between; align-items:center; padding: 10px 20px;">
        <h3>🔍 Các chuyến hôm nay</h3>
        <form method="get" style="display:flex; gap:8px; align-items:center; margin:0; flex-wrap:nowrap">
            <input type="hidden" name="locTrangThai" value="@locTrangThai" />
            
            <select name="maTinhDi" class="form-control" onchange="this.form.submit()" style="padding:4px 10px; font-size:0.85rem; border-radius:6px; height:auto; width:auto; max-width:130px">
                <option value="">-- Đi --</option>
                @foreach (var t in dsTinh) { <option value="@t.MaTinh" selected="@(t.MaTinh == maTinhDi ? "selected" : null)">@t.TenTinh</option> }
            </select>
            <span style="font-size:1.1rem; color:#2563eb">⇄</span>
            <select name="maTinhDen" class="form-control" onchange="this.form.submit()" style="padding:4px 10px; font-size:0.85rem; border-radius:6px; height:auto; width:auto; max-width:130px">
                <option value="">-- Đến --</option>
                @foreach (var t in dsTinh) { <option value="@t.MaTinh" selected="@(t.MaTinh == maTinhDen ? "selected" : null)">@t.TenTinh</option> }
            </select>
            
            <div style="width:1px; height:20px; background:#e2e8f0; margin:0 2px"></div>
            
            <span style="font-size:0.8rem; color:#64748b">Lọc:</span>
            <select name="locTrangThaiChuyen" class="form-control" onchange="this.form.submit()" style="padding:4px 10px; font-size:0.85rem; border-radius:6px; height:auto; width:auto; max-width:130px">
                <option value="">-- Trạng thái --</option>
                <option value="SAPDI" selected="@(locTrangThaiChuyen == "SAPDI" ? "selected" : null)">Sắp đi</option>
                <option value="DANGDI" selected="@(locTrangThaiChuyen == "DANGDI" ? "selected" : null)">Đang đi</option>
                <option value="HOANTHANH" selected="@(locTrangThaiChuyen == "HOANTHANH" ? "selected" : null)">Hoàn thành</option>
                <option value="HOAN" selected="@(locTrangThaiChuyen == "HOAN" ? "selected" : null)">Hoãn</option>
                <option value="HUY" selected="@(locTrangThaiChuyen == "HUY" ? "selected" : null)">Hủy</option>
            </select>
        </form>
    </div>
    <div class="panel-body table-wrap" style="padding:0">
        @if (chuyenHomNayList.Any())
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Tuyến</th>
                        <th>Giờ đi</th>
                        <th>Ghế trống</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in chuyenHomNayList)
                    {
                        <tr>
                            <td style="font-weight:700;color:#1e293b">@c.MaChuyen</td>
                            <td>
                                <div style="font-weight:600">@c.TinhDi → @c.TinhDen</div>
                                <div style="font-size:.75rem;color:#64748b">@c.BenDi → @c.BenDen</div>
                            </td>
                            <td style="font-weight:700;color:#2563eb">@c.GioDi.ToString("HH:mm")</td>
                            <td>
                                <span class="badge @(c.SoGheTrong>0?"badge-green":"badge-red")">@(c.SoGheTrong)/@(c.TongGheTot)</span>
                            </td>
                            <td>
                                @if (c.TrangThaiChuyen == "SAPDI") { <span class="badge badge-blue">Sắp đi</span> }
                                else if (c.TrangThaiChuyen == "DANGDI") { <span class="badge badge-orange">Đang đi</span> }
                                else if (c.TrangThaiChuyen == "HOANTHANH") { <span class="badge badge-green">Hoàn thành</span> }
                                else if (c.TrangThaiChuyen == "HOAN") { <span class="badge badge-yellow">Hoãn</span> }
                                else if (c.TrangThaiChuyen == "HUY") { <span class="badge badge-red">Hủy</span> }
                                else { <span class="badge">@(c.TrangThaiChuyen ?? "MỚI")</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div style="padding:30px; text-align:center; color:#94a3b8">
                <div style="font-size:2rem; margin-bottom:10px">🚌</div>
                Không có chuyến xe nào.
            </div>
        }
    </div>
</div>
</div>
