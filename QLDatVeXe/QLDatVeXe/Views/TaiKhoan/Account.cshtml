@using QLDatVeXe.Models
@{
    ViewData["Title"] = "Tài khoản — BusGo";
    ViewData["ActiveNav"] = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string activeTab = ViewData["Tab"]?.ToString() ?? "orders";
    
    var kh = ViewBag.KhachHang as Khachhang;
    var orders = ViewBag.Orders as List<Dondatve>;
}

@section PageCss {
  <link rel="stylesheet" href="~/assets/css/account.css" asp-append-version="true" />
}

<div class="container account-layout" style="padding-top:32px;padding-bottom:60px">

  <!-- SIDEBAR -->
  <aside class="account-sidebar">
    <div class="card card-body" style="text-align:center;padding-bottom:20px">
      <div class="account-avatar" id="acc-avatar">@kh?.HoTen.Substring(0,1).ToUpper()</div>
      <div class="account-name" id="acc-name">@kh?.HoTen</div>
      <div class="account-phone" id="acc-phone">@kh?.Sdt</div>
    </div>
    <nav class="acc-nav">
      <a class="acc-nav-item @(activeTab=="orders"?"active":"")" href="/Account?tab=orders">🎫 Lịch sử đặt vé</a>
      <a class="acc-nav-item @(activeTab=="profile"?"active":"")" href="/Account?tab=profile">👤 Thông tin cá nhân</a>
      <a class="acc-nav-item @(activeTab=="reviews"?"active":"")" href="/Account?tab=reviews">⭐ Đánh giá của tôi</a>
      <a class="acc-nav-item danger" href="/Logout">🚪 Đăng xuất</a>
    </nav>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="account-main">

    @* ─── ORDERS TAB ─── *@
    @if (activeTab == "orders")
    {
      <div class="tab-panel active">
        <div class="tab-header">
          <h2>🎫 Lịch sử đặt vé</h2>
          <div class="order-filters">
            <select class="form-control" style="width:auto" id="order-filter" onchange="filterOrders()">
              <option value="">Mới nhất</option>
              <option value="CHOXULY">CHOXULY</option>
              <option value="THANHCONG">THANHCONG</option>
              <option value="DAHUY">DAHUY</option>
              <option value="BOCHUYEN">BOCHUYEN</option>
            </select>
          </div>
        </div>
        <div id="orders-list">
          @if(orders != null && orders.Count > 0)
          {
              foreach(var o in orders)
              {
                  string displayStatus = o.TrangThai;
                  string statusClass = "badge-gray";
                  if(displayStatus == "THANHCONG") statusClass = "badge-success";
                  if(displayStatus == "DAHUY" || displayStatus == "BOCHUYEN") statusClass = "badge-danger";
                  if(displayStatus == "CHOXULY") statusClass = "badge-warning";
                  
                  <a href="/TicketDetail?maDon=@o.MaDon" class="order-card-link" style="text-decoration:none; color:inherit; display:block; margin-bottom:16px;">
                      <div class="card card-body order-card" data-status="@displayStatus" style="transition: transform 0.2s, box-shadow 0.2s; border:1px solid #e2e8f0;">
                          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; padding-bottom:12px; border-bottom:1px dashed #e2e8f0;">
                              <div>
                                  <span style="font-weight:700; font-size:1.1rem; color:var(--primary);">@o.MaDon</span>
                                  <span style="font-size:0.85rem; color:var(--gray-500); margin-left:12px;">@o.NgayDat?.ToString("dd/MM/yyyy HH:mm")</span>
                              </div>
                              <span class="badge @statusClass">@displayStatus</span>
                          </div>
                          <div style="display:flex; justify-content:space-between; align-items:flex-end;">
                              <div>
                                  <div style="margin-bottom:8px; font-weight:600;">Số lượng ghế: @o.Chitietdatve.Count</div>
                                  <div style="font-size:0.85rem; color:var(--gray-500);">Hành khách: @o.Tennguoidi - @o.Sdtnguoidi</div>
                              </div>
                              <div style="text-align:right;">
                                  <div style="font-size:0.85rem; color:var(--gray-500); margin-bottom:4px;">Tổng tiền</div>
                                  <div style="font-size:1.2rem; font-weight:800; color:var(--primary);">@o.TongTien?.ToString("N0")₫</div>
                              </div>
                          </div>
                      </div>
                  </a>
              }
          }
          else
          {
              <div class="empty-state-orders" style="text-align:center; padding:60px 20px; color:#94a3b8;">
                <div style="font-size:3rem; margin-bottom:16px;">🎫</div>
                <div style="font-size:1.1rem; font-weight:600; color:#64748b; margin-bottom:8px;">Chưa có đơn đặt vé nào</div>
                <div style="font-size:0.88rem; margin-bottom:24px;">Lịch sử đặt vé của bạn sẽ hiển thị ở đây.</div>
                <a href="/Search" class="btn btn-primary" style="display:inline-block;">🔍 Tìm chuyến xe ngay</a>
              </div>
          }
        </div>
      </div>
    }

    @* ─── PROFILE TAB ─── *@
    @if (activeTab == "profile")
    {
      <div class="tab-panel active">
        <div class="tab-header"><h2>👤 Thông tin cá nhân</h2></div>
        <div class="card card-body">
          <form method="post" action="/Account">
            <div class="grid-2">
              <div class="form-group">
                <label class="form-label">Họ tên</label>
                <input type="text" class="form-control" name="hoTen" value="@kh?.HoTen" required />
              </div>
              <div class="form-group">
                <label class="form-label">Số điện thoại</label>
                <input type="tel" class="form-control" name="sdt" value="@kh?.Sdt" required />
              </div>
              <div class="form-group">
                <label class="form-label">Tên đăng nhập</label>
                <input type="text" class="form-control" value="@kh?.TenDangNhap" readonly style="background:#f1f5f9;" />
              </div>
              <div class="form-group">
                <label class="form-label">Ngày tạo tài khoản</label>
                <input type="text" class="form-control" value="@kh?.NgayTao?.ToString("dd/MM/yyyy")" readonly style="background:#f1f5f9;" />
              </div>
            </div>
            <div style="margin-top:20px">
              <button type="submit" class="btn btn-primary">💾 Lưu thay đổi</button>
            </div>
          </form>
        </div>
      </div>
    }

    @* ─── REVIEWS TAB ─── *@
    @if (activeTab == "reviews")
    {
      <div class="tab-panel active">
        <div class="tab-header"><h2>⭐ Đánh giá của tôi</h2></div>
        <div id="reviews-list">
          <div style="text-align:center; padding:60px 20px; color:#94a3b8;">
            <div style="font-size:3rem; margin-bottom:16px;">⭐</div>
            <div style="font-size:1.1rem; font-weight:600; color:#64748b; margin-bottom:8px;">Chưa có đánh giá nào</div>
            <div style="font-size:0.88rem;">Tính năng đánh giá đang được phát triển.</div>
          </div>
        </div>
      </div>
    }

  </main>
</div>

<!-- REVIEW MODAL -->
<div class="modal-overlay" id="review-modal">
  <div class="modal">
    <div class="modal-header">
      <h3>⭐ Đánh giá chuyến xe</h3>
      <button class="modal-close" onclick="closeModal('review-modal')">×</button>
    </div>
    <div class="modal-body">
      <p class="text-muted mb-16" id="review-trip-label">Chuyến xe --</p>
      <div class="form-group mb-16">
        <label class="form-label">Điểm đánh giá (1–5)</label>
        <div class="star-rating" id="star-rating">
          <span class="star-btn" data-v="1" onclick="setStar(1)">★</span>
          <span class="star-btn" data-v="2" onclick="setStar(2)">★</span>
          <span class="star-btn" data-v="3" onclick="setStar(3)">★</span>
          <span class="star-btn" data-v="4" onclick="setStar(4)">★</span>
          <span class="star-btn" data-v="5" onclick="setStar(5)">★</span>
        </div>
      </div>
      <div class="form-group mb-16">
        <label class="form-label">Bình luận</label>
        <textarea class="form-control" id="review-comment" rows="3" placeholder="Chia sẻ trải nghiệm của bạn..."></textarea>
      </div>
      <button class="btn btn-primary btn-block" onclick="submitReview()">Gửi đánh giá</button>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    function filterOrders() {
      const val = document.getElementById('order-filter').value;
      document.querySelectorAll('.order-card').forEach(card => {
        const st = card.getAttribute('data-status');
        card.closest('.order-card-link').style.display = (!val || st === val) ? 'block' : 'none';
      });
    }
  </script>
  <script src="~/assets/js/account.js" asp-append-version="true"></script>
}
