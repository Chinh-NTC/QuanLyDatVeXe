<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] — BusGo</title>
  <meta name="description" content="@(ViewData["Description"] ?? "Đặt vé xe online dễ dàng, nhanh chóng. Tìm kiếm hàng trăm tuyến xe, chọn ghế linh hoạt, thanh toán an toàn.")" />
  <link rel="stylesheet" href="~/assets/css/style.css" asp-append-version="true" />
  @RenderSection("PageCss", required: false)
</head>
<body class="@ViewData["BodyClass"]">

@* NAVBAR *@
<nav class="navbar">
  <div class="container">
    <div class="navbar-inner">
      <a href="/" class="navbar-logo">
        <div class="logo-icon"><img src="~/assets/img/logo.svg" alt="BusGo Logo"></div>
        <span class="logo-text">BusGo</span>
      </a>
      <ul class="navbar-menu" id="navbar-menu">
        <li><a href="/" class="@(ViewData["ActiveNav"]?.ToString() == "home" ? "active" : "")">Trang chủ</a></li>
        <li><a href="/Search" class="@(ViewData["ActiveNav"]?.ToString() == "search" ? "active" : "")">Tìm chuyến</a></li>
        <li><a href="/NhaXe" class="@(ViewData["ActiveNav"]?.ToString() == "nhaxe" ? "active" : "")">Nhà xe</a></li>
      </ul>
      <div class="navbar-actions" id="navbar-actions">
        @{
            var userSession = QLDatVeXe.Helpers.SessionHelper.GetCurrentUser(Context.Session);
        }
        @if (userSession != null)
        {
            var userName = userSession.HoTen ?? "Khách";
            <a href="/Account" class="btn btn-ghost" style="display:flex; align-items:center; gap:8px; text-decoration:none;">
              <div style="width:32px; height:32px; border-radius:50%; background:var(--primary); color:white; display:flex; align-items:center; justify-content:center; font-weight:bold;">
                 @(userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "U")
              </div>
              <span>@userName</span>
            </a>
        }
        else
        {
            <a href="/Login" class="btn btn-ghost">Đăng nhập</a>
            <a href="/Register" class="btn btn-primary">Đăng ký</a>
        }
      </div>
      <button class="hamburger" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

@RenderBody()

@* FOOTER *@
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="logo">🚌 BusGo</div>
        <p>Nền tảng đặt vé xe trực tuyến hàng đầu, kết nối hành khách với hàng trăm nhà xe uy tín trên toàn quốc.</p>
      </div>
      <div>
        <h5>Dịch vụ</h5>
        <ul>
          <li><a href="/Search">Tìm chuyến xe</a></li>
          <li><a href="/Account?tab=orders">Lịch sử đặt vé</a></li>
        </ul>
      </div>
      <div>
        <h5>Liên hệ</h5>
        <ul>    
          <li><a href="#">📞 0339255698</a></li>
          <li><a href="#">✉️ support@busgo.vn</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 BusGo. Tất cả quyền được bảo lưu.</span>
    </div>
  </div>
</footer>

<div id="toast-container"></div>
<script src="~/assets/js/app.js" asp-append-version="true"></script>
@if (TempData["Success"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            if (typeof showToast === "function") {
                showToast('@TempData["Success"]', 'success');
            }
        });
    </script>
}
@if (TempData["Error"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            if (typeof showToast === "function") {
                showToast('@TempData["Error"]', 'error');
            }
        });
    </script>
}
@RenderSection("Scripts", required: false)
</body>
</html>
