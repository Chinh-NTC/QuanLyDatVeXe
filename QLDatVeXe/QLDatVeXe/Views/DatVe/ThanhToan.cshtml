@using QLDatVeXe.Models
@{
    ViewData["Title"] = "Thanh toán — BusGo";
    ViewData["ActiveNav"] = "search";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var cx = ViewBag.ChuyenXe as VChuyenxe;
    string maGhes = ViewBag.MaGhes as string ?? "";
    int soGhe = ViewBag.SoGhe ?? 0;
    decimal tongTien = ViewBag.TongTien ?? 0;
    
    var arrGhe = maGhes.Split(',', StringSplitOptions.RemoveEmptyEntries);
    var gioDen = cx?.GioDi.Add(TimeSpan.FromMinutes((double)(cx?.ThoiGianDuKien ?? 0)));
}

@section PageCss {
  <link rel="stylesheet" href="~/assets/css/payment.css" asp-append-version="true" />
}

<!-- STEPS BAR -->
<div class="steps-bar">
  <div class="container">
    <div class="steps">
      <div class="step done"><span class="step-num">1</span><span class="step-label">Tìm chuyến</span></div>
      <div class="step-line done"></div>
      <div class="step done"><span class="step-num">2</span><span class="step-label">Chọn ghế</span></div>
      <div class="step-line done"></div>
      <div class="step active"><span class="step-num">3</span><span class="step-label">Thanh toán</span></div>
    </div>
  </div>
</div>

<div class="container payment-layout" style="padding-top:32px;padding-bottom:60px">
  <form id="payment-form" action="/DatVe/ConfirmPayment" method="post" class="payment-main">
    <input type="hidden" name="maChuyen" value="@cx?.MaChuyen" />
    <input type="hidden" name="maGhe" value="@maGhes" />
    <input type="hidden" name="hoTenNguoiDi" value="@ViewBag.HoTenNguoiDi" />
    <input type="hidden" name="sdtNguoiDi" value="@ViewBag.SdtNguoiDi" />
    <input type="hidden" name="maKM" id="hidden-makm" value="" />
    
    <!-- LEFT: Form thanh toán -->
    <!-- Trip Summary - Premium -->
    @if(cx != null) {
    <div class="card card-body mb-24" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); color: white; border: none; box-shadow: 0 10px 25px -5px rgba(59,130,246,0.4); padding: 20px 28px; border-radius: 16px;">
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
        <div style="display:flex; align-items:center; gap:20px; flex: 1;">
          <div style="text-align:center;">
            <div style="font-size:1.6rem; font-weight:800; line-height:1;" id="pay-trip-gio-di">@cx.GioDi.ToString(@"hh\:mm")</div>
            <div style="font-size:0.85rem; opacity:0.9; margin-top:6px; font-weight:500;" id="pay-trip-ben-di">@cx.TinhDi (@cx.BenDi)</div>
          </div>
          <div style="display:flex; flex-direction:column; align-items:center; flex: 1; max-width: 150px;">
            <div style="width:100%; height:2px; background:rgba(255,255,255,0.4); position:relative; margin:8px 0; border-radius:2px;">
              <div style="position:absolute; right:50%; top:-10px; transform:translateX(50%); font-size:16px;">🚌</div>
            </div>
          </div>
          <div style="text-align:center;">
            <div style="font-size:1.6rem; font-weight:800; line-height:1;" id="pay-trip-gio-den">@gioDen?.ToString(@"hh\:mm")</div>
            <div style="font-size:0.85rem; opacity:0.9; margin-top:6px; font-weight:500;" id="pay-trip-ben-den">@cx.TinhDen (@cx.BenDen)</div>
          </div>
        </div>
        <div style="text-align:right; border-left:1px solid rgba(255,255,255,0.2); padding-left:20px;">
          <div style="font-size:0.8rem; opacity:0.8; margin-bottom:4px; text-transform:uppercase; letter-spacing:1px;">Ngày đi</div>
          <div style="font-weight:700; font-size:1.1rem; margin-bottom:8px;" id="pay-trip-ngay-di">@cx.NgayDi.ToString("dd/MM/yyyy")</div>
          <div style="font-weight:600; font-size:0.9rem; background:rgba(255,255,255,0.2); padding:2px 8px; border-radius:4px; display:inline-block;">🏢 <span id="pay-trip-nha-xe">@cx.TenNhaXe</span></div>
        </div>
      </div>
    </div>
    }

    <!-- Người đi thực tế -->
    <div class="card card-body mb-24">
      <h3 class="mb-16">👤 Thông tin hành khách</h3>
      
      <div class="grid-2">
        <div class="form-group">
          <label class="form-label">Người đặt vé</label>
          <input type="text" class="form-control" value="@ViewBag.HoTenKhach - @ViewBag.SdtKhach" readonly style="background:#f1f5f9; cursor:not-allowed;" />
        </div>
        <div class="form-group">
          <label class="form-label">Hành khách thực tế đi</label>
          <input type="text" class="form-control" value="@ViewBag.HoTenNguoiDi - @ViewBag.SdtNguoiDi" readonly style="background:#f1f5f9; color: var(--primary); font-weight: 600; cursor:not-allowed;" />
        </div>
      </div>
      <p style="font-size:0.85rem; color:#64748b; margin-top: 8px;">ℹ️ Đây là thông tin đã được chọn ở bước Chọn Ghế. Thông tin này sẽ được dùng để lên xe.</p>
    </div>

    <!-- Ghế đã chọn -->
    <div class="card card-body mb-24">
      <h3 class="mb-16">🪑 Ghế đã chọn</h3>
      <div id="pay-seat-list">
        @foreach(var g in arrGhe) {
        <div class="pay-seat-row" style="display:flex;justify-content:space-between;padding:12px;border-bottom:1px solid #f3f4f6">
          <div class="pay-seat-badge" style="background:var(--primary-light);color:var(--primary);padding:4px 10px;border-radius:6px;font-size:.85rem;font-weight:600">🪑 Ghế @g</div>
          <div style="font-weight:600">@cx?.GiaVe.ToString("N0")₫</div>
        </div>
        }
      </div>
    </div>

    <!-- Phương thức thanh toán -->
    <div class="card card-body mb-24">
      <h3 class="mb-16">💳 Phương thức thanh toán</h3>
      <p class="text-sm text-muted mb-16">Chọn phương thức thanh toán phù hợp với bạn</p>
      <div class="payment-methods">
        <label class="pay-method active" id="pm-tienmat">
          <input type="radio" name="phuongThuc" value="tien-mat" checked onchange="selectMethod('TIENMAT')" />
          <div class="pm-icon">💵</div>
          <div>
            <div class="pm-name">Tiền mặt</div>
            <div class="pm-desc">Thanh toán khi lên xe hoặc tại bến</div>
          </div>
          <div class="pm-check">✓</div>
        </label>

        <div id="cash-warning" style="background:#fffbeb; border:1px solid #fde68a; color:#b45309; padding:12px; border-radius:8px; margin-top:-10px; margin-bottom:16px; font-size:0.85rem;">
          ⚠️ <strong>Lưu ý:</strong> Vui lòng có mặt tại bến trước giờ khởi hành ít nhất <strong>30 phút</strong> để thanh toán tiền mặt và nhận vé.
        </div>

        <label class="pay-method" id="pm-chuyenkhoan">
          <input type="radio" name="phuongThuc" value="chuyen-khoan" onchange="selectMethod('CHUYENKHOAN')" />
          <div class="pm-icon">🏦</div>
          <div>
            <div class="pm-name">Chuyển khoản ngân hàng</div>
            <div class="pm-desc">Chuyển khoản trước, xác nhận qua SMS</div>
          </div>
          <div class="pm-check">✓</div>
        </label>
      </div>

      <!-- Bank info -->
      <div class="bank-info hidden" id="bank-info">
        <div class="bank-info-box">
          <div class="bank-detail"><span>Ngân hàng</span><strong>Vietcombank</strong></div>
          <div class="bank-detail"><span>Số tài khoản</span><strong class="copy-text" onclick="copyText('0123456789')">0123456789 📋</strong></div>
          <div class="bank-detail"><span>Chủ tài khoản</span><strong>CÔNG TY BUSGO</strong></div>
          <div class="bank-detail"><span>Số tiền cần TT</span><strong id="bank-amount" style="color:var(--primary)">@tongTien.ToString("N0")₫</strong></div>
          <div class="bank-detail"><span>Nội dung CK</span><strong id="bank-content" class="copy-text">BusGo @ViewBag.SdtNguoiDi</strong></div>
        </div>
        <p style="font-size:.82rem;color:var(--warning);margin-top:10px">
          ⚠️ Chuyển khoản trong 30 phút. Đặt vé tự động hủy nếu chưa thanh toán.
        </p>
      </div>
    </div>

    <!-- Khuyến mãi -->
    <div class="card card-body mb-24">
      <h3 class="mb-16">🎁 Mã khuyến mãi / Giảm giá</h3>
      <div style="display: flex; gap: 12px; margin-bottom: 12px;">
        <select id="km-select" class="form-control" style="flex: 1;" onchange="applyPromo()">
          <option value="">-- Chọn mã khuyến mãi có sẵn --</option>
          @if(ViewBag.KhuyenMais != null) {
            foreach(var km in ViewBag.KhuyenMais as List<Khuyenmai>) {
              <option value="@km.TenKhuyenMai">@km.TenKhuyenMai - Giảm @(string.Equals(km.LoaiKm, "CODINH", StringComparison.OrdinalIgnoreCase) || string.Equals(km.LoaiKm, "TienMat", StringComparison.OrdinalIgnoreCase) ? km.GiaTriGiam.ToString("N0") + "đ" : km.GiaTriGiam.ToString("G29") + "%")</option>
            }
          }
        </select>
      </div>
      <div style="display: flex; gap: 12px;">
        <input type="text" id="km-input" class="form-control" placeholder="Hoặc nhập mã khuyến mãi..." style="flex: 1;" />
        <button type="button" class="btn btn-primary" onclick="applyPromoInput()">Áp dụng</button>
      </div>
      <div id="promo-message" style="margin-top: 8px; font-size: 0.85rem; font-weight: 600;"></div>
    </div>

    <!-- Terms -->
    <div class="terms-check">
      <input type="checkbox" id="accept-terms" onchange="checkReady()" />
      <label for="accept-terms">
        Tôi đồng ý với <a href="#" style="color:var(--primary)">Điều khoản dịch vụ</a> và
        <a href="#" style="color:var(--primary)">Chính sách hủy vé</a> của BusGo
      </label>
    </div>

    <button type="submit" class="btn btn-primary btn-block btn-lg" id="btn-confirm" disabled style="margin-top:20px">
      🎫 Xác nhận đặt vé
    </button>
    <a href="/DatVe/ChonGhe?maChuyen=@cx?.MaChuyen" class="btn btn-ghost btn-block" style="margin-top:8px">← Quay lại chọn ghế</a>
  </form>

  <!-- RIGHT: Order summary -->
  <aside class="payment-sidebar">
    <div class="card card-body">
      <h3 class="mb-16">🧾 Tóm tắt đơn hàng</h3>

      <div id="pay-summary-rows">
        @foreach(var g in arrGhe) {
        <div class="summary-row"><span>Ghế @g</span><span>@cx?.GiaVe.ToString("N0")₫</span></div>
        }
      </div>

      <div class="divider"></div>

      <div class="summary-row" style="padding:14px 0">
        <span style="font-weight:700;font-size:1rem">Tổng cộng</span>
        <strong class="price-tag" id="pay-total">@tongTien.ToString("N0")₫</strong>
      </div>
      <div class="summary-row" id="discount-row" style="display: none; padding-bottom: 14px; color: var(--success);">
        <span>Khuyến mãi</span>
        <strong id="pay-discount-amount">-0₫</strong>
      </div>
      <div class="summary-row">
        <span style="color:var(--primary)">Tiền cần thanh toán</span>
        <strong id="pay-deposit" style="color:var(--primary);font-size:1.1rem">@tongTien.ToString("N0")₫</strong>
      </div>

      <div class="divider"></div>
      <div style="font-size:.8rem;color:var(--gray-500);line-height:1.6">
        <p>🔒 Giao dịch được bảo mật SSL</p>
        <p>📞 Hỗ trợ: 1900 xxxx (7:00–22:00)</p>
        <p>⏰ Giữ ghế trong <strong id="countdown" style="color:var(--danger)">10:00</strong></p>
      </div>
    </div>
  </aside>
</div>

@section Scripts {
  <script>
    const GIA_GOC = @tongTien;
    const DS_KHUYEN_MAI = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.KhuyenMais ?? new List<Khuyenmai>()));

    function formatVND(amount) {
        return amount.toLocaleString('vi-VN') + "₫";
    }

    function calculateDiscount(km) {
        if (!km) return 0;
        let discount = 0;
        const loaiKm = (km.LoaiKm || '').toUpperCase();
        if (loaiKm === 'PHANTRAM' || loaiKm === '') {
            discount = GIA_GOC * (km.GiaTriGiam / 100);
        } else {
            discount = km.GiaTriGiam;
        }
        return discount > GIA_GOC ? GIA_GOC : discount;
    }

    function applyPromo() {
        const select = document.getElementById('km-select');
        const input = document.getElementById('km-input');
        input.value = select.value;
        updatePromoUI(select.value);
    }

    function applyPromoInput() {
        const input = document.getElementById('km-input');
        const select = document.getElementById('km-select');
        const val = input.value.trim().toUpperCase();
        
        // Find if it exists in the list
        const exists = DS_KHUYEN_MAI.find(k => k.TenKhuyenMai.toUpperCase() === val);
        if (exists) {
            select.value = exists.TenKhuyenMai;
            updatePromoUI(exists.TenKhuyenMai);
        } else {
            select.value = "";
            document.getElementById('promo-message').innerHTML = '<span style="color: var(--danger);">Mã khuyến mãi không hợp lệ hoặc đã được sử dụng.</span>';
            resetPrice();
        }
    }

    function resetPrice() {
        document.getElementById('hidden-makm').value = "";
        document.getElementById('discount-row').style.display = 'none';
        document.getElementById('pay-deposit').innerText = formatVND(GIA_GOC);
        document.getElementById('bank-amount').innerText = formatVND(GIA_GOC);
    }

    function updatePromoUI(tenKm) {
        const msgBox = document.getElementById('promo-message');
        if (!tenKm) {
            msgBox.innerHTML = '';
            resetPrice();
            return;
        }
        const km = DS_KHUYEN_MAI.find(k => k.TenKhuyenMai === tenKm);
        if (km) {
            const discount = calculateDiscount(km);
            document.getElementById('hidden-makm').value = tenKm;
            
            msgBox.innerHTML = `<span style="color: var(--success);">Áp dụng thành công mã ${tenKm}!</span>`;
            
            document.getElementById('discount-row').style.display = 'flex';
            document.getElementById('pay-discount-amount').innerText = '-' + formatVND(discount);
            
            const newTotal = GIA_GOC - discount;
            document.getElementById('pay-deposit').innerText = formatVND(newTotal);
            
            const bankEl = document.getElementById('bank-amount');
            if (bankEl) bankEl.innerText = formatVND(newTotal);
        } else {
            resetPrice();
        }
    }

    function selectMethod(method) {
      const cashWarning = document.getElementById('cash-warning');
      const bankInfo = document.getElementById('bank-info');
      document.querySelectorAll('.pay-method').forEach(m => m.classList.remove('active'));
      document.getElementById('pm-' + method.toLowerCase()).classList.add('active');
      if (method === 'CHUYENKHOAN') { cashWarning.style.display='none'; bankInfo.classList.remove('hidden'); }
      else { cashWarning.style.display='block'; bankInfo.classList.add('hidden'); }
    }
    
    function checkReady() {
      const checked = document.getElementById('accept-terms').checked;
      document.getElementById('btn-confirm').disabled = !checked;
    }
  </script>
  <script src="~/assets/js/payment.js" asp-append-version="true"></script>
}
