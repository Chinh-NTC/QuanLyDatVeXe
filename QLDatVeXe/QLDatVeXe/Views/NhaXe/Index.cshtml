@using QLDatVeXe.Models
@{
    ViewData["Title"] = "Danh sách Nhà xe — BusGo";
    ViewData["Description"] = "Khám phá các nhà xe uy tín trên BusGo. Thông tin về xe, tuyến đường và dịch vụ.";
    ViewData["ActiveNav"] = "nhaxe";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var nhaXes = ViewBag.Nhaxe as List<Nhaxe>;
}

@section PageCss {
  <style>
    .nhaxe-hero {
      background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 60%, #7c3aed 100%);
      color: white; padding: 60px 0 40px; text-align: center; position: relative; overflow: hidden;
    }
    .nhaxe-hero::before {
      content: ''; position: absolute; inset: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .nhaxe-hero h1 { font-size: 2.6rem; font-weight: 800; margin-bottom: 12px; text-shadow: 0 4px 8px rgba(0,0,0,0.4); letter-spacing: 1px; }
    .nhaxe-hero p  { font-size: 1.15rem; font-weight: 500; opacity: 1; text-shadow: 0 2px 4px rgba(0,0,0,0.3); }
    .nhaxe-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; margin-top: 32px; }
    .nhaxe-card {
      background: white; border-radius: 16px; border: 1px solid #e2e8f0; padding: 24px;
      cursor: pointer; transition: all .3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; flex-direction: column; gap: 16px;
      text-decoration: none; color: inherit; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
      position: relative; overflow: hidden;
    }
    .nhaxe-card::after {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, #2563eb, #7c3aed);
      transform: scaleX(0); transform-origin: left; transition: transform 0.3s ease;
    }
    .nhaxe-card:hover { transform: translateY(-6px); box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04); border-color: transparent; }
    .nhaxe-card:hover::after { transform: scaleX(1); }
    
    .nhaxe-card-header { display: flex; align-items: center; gap: 16px; }
    .nx-avatar { width: 64px; height: 64px; background: linear-gradient(135deg, #e0e7ff, #ede9fe); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; flex-shrink: 0; color: #4f46e5; font-weight: 800; box-shadow: inset 0 2px 4px rgba(255,255,255,0.5); }
    .nx-name { font-weight: 800; font-size: 1.15rem; color: #1e293b; line-height: 1.3; }
    .nx-sub  { font-size: .85rem; color: var(--gray-500); margin-top: 4px; display: flex; align-items: center; gap: 6px;}
    .nx-badge { display: inline-flex; align-items: center; gap: 4px; background: #dcfce7; color: #166534; border-radius: 99px; padding: 2px 8px; font-size: .75rem; font-weight: 600; }
    
    .nx-stats { display: flex; gap: 16px; border-top: 1px dashed #e2e8f0; padding-top: 16px; margin-top: auto; }
    .nx-stat { flex: 1; text-align: center; }
    .nx-stat-val { font-weight: 800; font-size: 1.1rem; color: #0f172a; }
    .nx-stat-lbl { font-size: .75rem; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 2px; }
    
    .nx-info { font-size: .85rem; color: var(--gray-600); display: flex; flex-direction: column; gap: 8px; }
    .nx-info-item { display: flex; gap: 8px; align-items: center; }
    .nx-info-icon { color: #94a3b8; width: 16px; text-align: center; }
    
    @@media (max-width: 640px) { .nhaxe-grid { grid-template-columns: 1fr; } .nhaxe-hero h1 { font-size: 1.8rem; } }
  </style>
}

<!-- HERO -->
<div class="nhaxe-hero">
  <div class="container" style="position:relative;z-index:1">
    <h1>🚌 Đối Tác Vận Tải</h1>
    <p>Khám phá @(nhaXes?.Count ?? 0) nhà xe uy tín đồng hành cùng BusGo trên mọi nẻo đường</p>
  </div>
</div>

<div class="container" style="padding-top:40px;padding-bottom:80px">
  <div class="nhaxe-grid" id="nhaxe-grid">
    @if (nhaXes != null && nhaXes.Count > 0)
    {
        foreach(var n in nhaXes)
        {
            <a href="/NhaXe/Detail?ma=@n.MaNhaXe" class="nhaxe-card">
              <div class="nhaxe-card-header">
                <div class="nx-avatar">@n.TenNhaXe.Substring(0,1).ToUpper()</div>
                <div>
                  <div class="nx-name">@n.TenNhaXe</div>
                  <div class="nx-sub">
                      <span class="nx-badge">✓ Uy tín</span>
                      <span>Tham gia từ 2026</span>
                  </div>
                </div>
              </div>
              <div class="nx-info">
                @if(!string.IsNullOrEmpty(n.Sdt)) {
                    <div class="nx-info-item"><span class="nx-info-icon">📞</span> @n.Sdt</div>
                }
                @if(!string.IsNullOrEmpty(n.Email)) {
                    <div class="nx-info-item"><span class="nx-info-icon">✉️</span> @n.Email</div>
                }
                @if(!string.IsNullOrEmpty(n.DiaChi)) {
                    <div class="nx-info-item"><span class="nx-info-icon">📍</span> @n.DiaChi</div>
                }
              </div>
              <div class="nx-stats">
                  <div class="nx-stat">
                      <div class="nx-stat-val">@n.Xe.Count</div>
                      <div class="nx-stat-lbl">Xe hoạt động</div>
                  </div>
                  <div class="nx-stat" style="border-left: 1px solid #e2e8f0;">
                      <div class="nx-stat-val">5.0 ⭐</div>
                      <div class="nx-stat-lbl">Đánh giá</div>
                  </div>
              </div>
            </a>
        }
    }
    else
    {
        <div style="grid-column:1/-1; text-align:center; padding:80px 20px; color:#94a3b8; background: white; border-radius: 16px; border: 1px dashed #cbd5e1;">
          <div style="font-size:4rem; margin-bottom:16px; opacity:0.5;">🏢</div>
          <div style="font-size:1.2rem; font-weight:600; margin-bottom:8px; color: #475569;">Chưa có dữ liệu nhà xe</div>
          <p>Hiện tại hệ thống chưa có thông tin nhà xe nào được đăng ký.</p>
        </div>
    }
  </div>
</div>
