@{
    ViewData["Title"] = "Danh sách Nhà xe — BusGo";
    ViewData["Description"] = "Khám phá các nhà xe uy tín trên BusGo. Thông tin về xe, tuyến đường và dịch vụ.";
    ViewData["ActiveNav"] = "nhaxe";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section PageCss {
  <style>
    .nhaxe-hero {
      background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 60%, #7c3aed 100%);
      color: white; padding: 60px 0 40px; text-align: center; position: relative; overflow: hidden;
    }
    .nhaxe-hero::before {
      content: ''; position: absolute; inset: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .nhaxe-hero h1 { font-size: 2.2rem; font-weight: 800; margin-bottom: 12px; }
    .nhaxe-hero p  { font-size: 1rem; opacity: .85; }
    .nhaxe-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; margin-top: 32px; }
    .nhaxe-card {
      background: white; border-radius: 16px; border: 1px solid #e2e8f0; padding: 24px;
      cursor: pointer; transition: all .25s ease; display: flex; flex-direction: column; gap: 16px;
      text-decoration: none; color: inherit; box-shadow: 0 2px 8px rgba(0,0,0,.04);
    }
    .nhaxe-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(37,99,235,.12); border-color: var(--primary); }
    .nhaxe-card-header { display: flex; align-items: center; gap: 16px; }
    .nx-avatar { width: 56px; height: 56px; background: linear-gradient(135deg, #2563eb, #7c3aed); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; flex-shrink: 0; }
    .nx-name { font-weight: 700; font-size: 1.05rem; color: #1e293b; }
    .nx-sub  { font-size: .82rem; color: var(--gray-500); margin-top: 2px; }
    .nx-badge { display: inline-flex; align-items: center; gap: 4px; background: var(--primary-light); color: var(--primary); border-radius: 99px; padding: 3px 10px; font-size: .78rem; font-weight: 600; }
    .nx-stats { display: flex; gap: 16px; border-top: 1px solid #f1f5f9; padding-top: 12px; }
    .nx-stat { flex: 1; text-align: center; }
    .nx-stat-val { font-weight: 700; font-size: 1.2rem; color: var(--primary); }
    .nx-stat-lbl { font-size: .75rem; color: var(--gray-500); }
    .nx-info { font-size: .83rem; color: var(--gray-600); display: flex; gap: 6px; align-items: flex-start; }
    .nx-info-item { display: flex; gap: 4px; align-items: center; }
    @@media (max-width: 640px) { .nhaxe-grid { grid-template-columns: 1fr; } .nhaxe-hero h1 { font-size: 1.6rem; } }
  </style>
}

<!-- HERO -->
<div class="nhaxe-hero">
