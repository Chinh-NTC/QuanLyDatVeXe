@{
    ViewData["Title"] = "Phương Trang — Nhà xe BusGo";
    ViewData["ActiveNav"] = "nhaxe";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section PageCss {
  <style>
    .nhaxe-detail-hero { background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 60%, #7c3aed 100%); color: white; padding: 48px 0 36px; }
    .nhaxe-back-link { display: inline-flex; align-items: center; gap: 6px; color: rgba(255,255,255,.8); font-size: .88rem; text-decoration: none; margin-bottom: 20px; transition: color .2s; }
    .nhaxe-back-link:hover { color: white; }
    .nhaxe-header-inner { display: flex; align-items: center; gap: 24px; }
    .nhaxe-logo-big { width: 72px; height: 72px; background: rgba(255,255,255,.15); border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 2.2rem; backdrop-filter: blur(8px); flex-shrink: 0; }
    .nhaxe-title-block h1 { font-size: 1.8rem; font-weight: 800; margin-bottom: 6px; }
    .nhaxe-meta-row { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 10px; }
    .nhaxe-meta-item { display: flex; align-items: center; gap: 6px; font-size: .88rem; opacity: .9; }
    .xe-section { padding: 32px 0 60px; }
    .xe-section-title { display: flex; align-items: center; gap: 10px; margin-bottom: 24px; }
    .xe-section-title h2 { font-size: 1.3rem; font-weight: 700; }
    .xe-count-badge { background: var(--primary); color: white; border-radius: 99px; padding: 2px 12px; font-size: .82rem; font-weight: 600; }
    .xe-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
    .xe-card { background: white; border-radius: 14px; border: 1px solid #e2e8f0; overflow: hidden; transition: all .25s ease; box-shadow: 0 2px 8px rgba(0,0,0,.04); }
    .xe-card:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(37,99,235,.1); border-color: #c7d2fe; }
    .xe-img-wrap { height: 160px; background: linear-gradient(135deg, #f1f5f9, #e2e8f0); display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative; }
    .xe-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
    .xe-img-placeholder { font-size: 4rem; opacity: .4; }
    .xe-status-badge { position: absolute; top: 10px; right: 10px; padding: 3px 10px; border-radius: 99px; font-size: .75rem; font-weight: 600; }
    .xe-status-SANSANG { background: #dcfce7; color: #166534; }
    .xe-status-BAOTRI { background: #fef3c7; color: #92400e; }
    .xe-status-DANGCHAY { background: #dbeafe; color: #1e40af; }
    .xe-body { padding: 16px; }
    .xe-bien-so { font-family: 'Courier New', monospace; font-weight: 700; font-size: 1rem; color: #1e293b; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 3px 10px; display: inline-block; margin-bottom: 8px; }
    .xe-loai { font-weight: 600; font-size: .95rem; color: #334155; margin-bottom: 6px; }
    .xe-meta-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
    .xe-chip { background: #f1f5f9; color: #64748b; border-radius: 99px; padding: 2px 10px; font-size: .77rem; }
    .xe-stats-row { display: flex; border-top: 1px solid #f1f5f9; padding-top: 12px; }
    .xe-stat { flex: 1; text-align: center; border-right: 1px solid #f1f5f9; }
    .xe-stat:last-child { border-right: none; }
    .xe-stat-val { font-weight: 700; font-size: 1.1rem; color: var(--primary); }
    .xe-stat-lbl { font-size: .72rem; color: var(--gray-400); }
    @@media (max-width: 640px) { .nhaxe-header-inner { flex-direction: column; align-items: flex-start; } .xe-grid { grid-template-columns: 1fr; } }
  </style>
}

<!-- HERO -->
<div class="nhaxe-detail-hero">
  <div class="container">
    <a href="/NhaXe" class="nhaxe-back-link">← Quay lại danh sách nhà xe</a>
    <div class="nhaxe-header-inner">
      <div class="nhaxe-logo-big">🏢</div>
      <div class="nhaxe-title-block">
        <h1>Phương Trang</h1>
        <span style="opacity:.7;font-size:.85rem">Mã: NX001</span>
        <div class="nhaxe-meta-row">
          <div class="nhaxe-meta-item">📞 1900 6067</div>
          <div class="nhaxe-meta-item">✉️ phuongtrang@mail.vn</div>
          <div class="nhaxe-meta-item">📍 123 Lê Lợi, Quận 1, TP. HCM</div>
          <div class="nhaxe-meta-item">🚌 12 xe</div>
        </div>
      </div>
    </div>
  </div>
</div>

